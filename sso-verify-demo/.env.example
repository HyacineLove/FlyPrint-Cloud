# Replace every endpoint with the UAT values provided by the SSO/Keycloak administrator.
# Do not use the production endpoint from the public document for UAT.
SSO_VERIFY_AUTHORIZATION_URL=https://sso-uat.example.edu/oauth2.0/authorize
SSO_VERIFY_TOKEN_URL=https://sso-uat.example.edu/oauth2.0/accessToken
SSO_VERIFY_USERINFO_URL=https://sso-uat.example.edu/oauth2.0/profile
SSO_VERIFY_CLIENT_ID=replace-with-uat-client-id
SSO_VERIFY_CLIENT_SECRET=replace-with-uat-client-secret-at-least-32-chars
SSO_VERIFY_SCOPE=ECNU-Basic
SSO_VERIFY_REDIRECT_URI=http://127.0.0.1:8090/callback
SSO_VERIFY_LISTEN_ADDR=127.0.0.1:8090
SSO_VERIFY_STATE_TTL=5m
SSO_VERIFY_HTTP_TIMEOUT=10s
