[Unit]
Description=FlyPrint Site Portal SSO verification demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hqit
WorkingDirectory=/home/hqit/fly-print-site-portal
EnvironmentFile=/home/hqit/fly-print-site-portal/.env
ExecStart=/home/hqit/fly-print-site-portal/sso-verify-demo-linux-amd64
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
UMask=0277

[Install]
WantedBy=multi-user.target
