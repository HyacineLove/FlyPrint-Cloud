# ============================================================
# FlyPrint Cloud 环境变量配置模板（供 docker-compose 使用）
# 局域网演示：可不复制本文件，直接 `docker compose up --build -d`
# （默认值已写在 docker-compose.yml）。需要改端口/密码时再复制为 .env。
# API 独立部署请使用 api/config.yaml，不使用本文件。
# 公网/生产：必须轮换下方所有示例密钥与密码；第三方对接见 docs/第三方接入指南.md
# ============================================================

# ===== 数据库配置 =====
POSTGRES_DB=fly_print_cloud
POSTGRES_USER=postgres
# 生产环境请使用强密码，生成方式: openssl rand -base64 32
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== API 服务配置 =====
API_PORT=8080
DOCKERHUB_MIRROR=docker.1ms.run
COMPOSE_LIBRARY_MIRROR=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io
MINIO_IMAGE_MIRROR=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io
STORAGE_PROVIDER=minio
STORAGE_DOWNLOAD_MODE=proxy
STORAGE_MAX_SIZE=10485760
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=fly-print-files
MINIO_USE_SSL=false
MINIO_OBJECT_PREFIX=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Admin Console 配置（仅在使用 docker-compose 构建时生效，admin/.env 会被忽略）=====
ADMIN_PORT=3000
# 前端 API/Auth 路径前缀（同域部署时通常与 Nginx 代理路径一致）
REACT_APP_API_BASE_PATH=/api/v1
REACT_APP_AUTH_BASE_PATH=/auth
# 子路径部署 Admin（如 UAT /fly-print-web）时同时设置：
# REACT_APP_API_BASE_PATH=/fly-print-api/api/v1
# REACT_APP_AUTH_BASE_PATH=/fly-print-api/auth
# REACT_APP_BASENAME=/fly-print-web
# PUBLIC_URL=/fly-print-web
# 旧版兼容：可写完整 URL，前端会只取 path 部分
# REACT_APP_API_URL=http://api:8080
REACT_APP_BASENAME=
PUBLIC_URL=

# ===== 对外端口（仅 docker-compose 生效）=====
# Nginx 暴露的 HTTP 端口；下方 ALLOWED_ORIGINS、ADMIN_CONSOLE_URL、OAUTH2_REDIRECT_URI 需与此端口一致
HTTP_PORT=8012

# ===== 外部访问配置 =====
# 本地开发/测试：与 HTTP_PORT 一致；Edge 调用 API 时使用 EXTERNAL_API_URL
EXTERNAL_API_URL=http://localhost:8012
EXTERNAL_ADMIN_URL=http://localhost:8012

# 生产环境示例（使用实际域名）
# EXTERNAL_API_URL=https://print.example.com
# EXTERNAL_ADMIN_URL=https://print.example.com

# ===== 管理员账户配置 =====
# 首次启动时是否创建默认管理员
CREATE_DEFAULT_ADMIN=true
# 默认管理员密码（生产环境请立即修改）
DEFAULT_ADMIN_PASSWORD=admin123

# ===== OAuth2 模式选择 =====
# builtin: 内置认证服务（校园网/LAN 部署，无需 Keycloak）
# keycloak: 外部 Keycloak 认证（生产/公网部署）
OAUTH2_MODE=builtin

# ===== 内置模式 (builtin) 配置 =====
# JWT 签名密钥（生产环境必须替换）
# 生成方式: openssl rand -hex 32
OAUTH2_JWT_SIGNING_SECRET=change-this-to-a-random-secret-32chars
# Token 过期时间（秒）
OAUTH2_JWT_TOKEN_EXPIRY=3600
# JWT 签发者
OAUTH2_JWT_ISSUER=fly-print-cloud
# OAuth Client Secret 加密主密钥（Base64 编码的 32 字节）
# 局域网演示默认值与 docker-compose.yml 一致；公网/生产必须轮换（openssl rand -base64 32）
# 丢失后只能重置客户端密钥
OAUTH_CLIENT_SECRET_ENCRYPTION_KEY=Zmx5cHJpbnQtZGVtby1hZXMta2V5LTMyYnl0ZXMhIQ==

# ===== Third-party integration =====
# Compose starts the internal Redis service. Set INTEGRATION_REDIS_URL only when
# an externally managed Redis service is required; use rediss:// for TLS.
REDIS_PASSWORD=change-me
INTEGRATION_DEMO_ADMIN_PASSWORD=demo123
# INTEGRATION_REDIS_URL=rediss://:password@redis.example.com:6380/0
# Comma-separated reverse-proxy CIDRs. Leave empty when the API is directly exposed.
# TRUSTED_PROXY_CIDRS=172.20.0.0/16

# ===== Keycloak 模式配置（OAUTH2_MODE=keycloak 时使用）=====
# OAuth2 客户端配置
OAUTH2_CLIENT_ID=fly-print-admin-console
OAUTH2_CLIENT_SECRET=your-keycloak-client-secret

# OAuth2 端点（浏览器直接访问）
OAUTH2_AUTH_URL=http://localhost:8090/realms/fly-print/protocol/openid-connect/auth
OAUTH2_LOGOUT_URL=http://localhost:8090/realms/fly-print/protocol/openid-connect/logout

# OAuth2 端点（API 容器内访问）
OAUTH2_TOKEN_URL=http://host.docker.internal:8090/realms/fly-print/protocol/openid-connect/token
OAUTH2_USERINFO_URL=http://host.docker.internal:8090/realms/fly-print/protocol/openid-connect/userinfo

# JWKS 端点
OAUTH2_JWKS_URL=http://host.docker.internal:8090/realms/fly-print/protocol/openid-connect/certs

# JWT Issuer（必须与 Keycloak 实际签发的 issuer 一致）
OAUTH2_ISSUER=http://localhost:8090/realms/fly-print

# 登出重定向参数名
OAUTH2_LOGOUT_REDIRECT_URI_PARAM=post_logout_redirect_uri

# OAuth2 回调 URI（必须与 Keycloak 中注册的一致）；端口需与 HTTP_PORT 一致
OAUTH2_REDIRECT_URI=http://localhost:8012/auth/callback

# Admin Console URL（端口需与 HTTP_PORT 一致）
ADMIN_CONSOLE_URL=http://localhost:8012

# ===== CORS 配置 =====
# 允许的前端来源，多个用逗号分隔
# 说明：
# - 扫码上传常用“局域网 IP + 端口”访问（例如 http://192.168.1.10:8012）
# - API 的 CORS 会严格按 Origin 白名单拦截，不在白名单会返回 403: origin not allowed
# - 这里给出 LAN 友好的默认值（覆盖常见私网网段）；如需更严格，可只保留你的实际域名/IP
ALLOWED_ORIGINS=http://localhost:8012,http://127.0.0.1:8012,http://192.168.*.*,http://10.*.*.*,http://172.16.*.*,http://172.17.*.*,http://172.18.*.*,http://172.19.*.*,http://172.2*.*.*,http://172.3*.*.*

# ===== Cookie 配置 =====
# HTTPS 环境必须为 true，本地 HTTP 设为 false
COOKIE_SECURE=false

# ===== 文件访问安全配置 =====
# 文件访问凭证签名密钥（生产环境必须设置为随机强密钥）
# 生成方式: openssl rand -hex 32
FILE_ACCESS_SECRET=change-this-to-a-random-secret-32chars
