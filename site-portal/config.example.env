SITE_PORTAL_CODE=official
SITE_PORTAL_DISPLAY_NAME=FlyPrint
SITE_PORTAL_CLOUD_API_BASE=https://cloud.example.com
SITE_PORTAL_CLOUD_CLIENT_ID=site-portal-official
SITE_PORTAL_CLOUD_CLIENT_SECRET=replace-with-random-secret-at-least-32-chars
SITE_PORTAL_IDENTITY_AUTHORIZATION_URL=https://keycloak.example.com/realms/fly/protocol/openid-connect/auth
SITE_PORTAL_IDENTITY_TOKEN_URL=https://keycloak.example.com/realms/fly/protocol/openid-connect/token
SITE_PORTAL_IDENTITY_USERINFO_URL=https://keycloak.example.com/realms/fly/protocol/openid-connect/userinfo
SITE_PORTAL_IDENTITY_CLIENT_ID=replace-with-oidc-client-id
SITE_PORTAL_IDENTITY_CLIENT_SECRET=replace-with-random-secret-at-least-32-chars
SITE_PORTAL_IDENTITY_SCOPE=openid
# Keycloak standard UserInfo claims.
SITE_PORTAL_IDENTITY_PROFILE_FORMAT=oidc
SITE_PORTAL_IDENTITY_CALLBACK_URL=https://portal.example.com/auth/callback
SITE_PORTAL_PRP_BASE_URL=https://prp.example.com
SITE_PORTAL_UPLOAD_ENABLED=false
SITE_PORTAL_PRP_API_BASE_URL=
SITE_PORTAL_USER_SESSION_TTL=1h
SITE_PORTAL_COOKIE_SECURE=true
SITE_PORTAL_PORT=8082
