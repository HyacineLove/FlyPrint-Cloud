# LAN address reachable by the Edge terminal and users' mobile browsers.
SITE_PORTAL_CODE=official
SITE_PORTAL_DISPLAY_NAME=FlyPrint
SITE_PORTAL_PORT=8082
SITE_PORTAL_PUBLIC_BASE_URL=https://portal.example.com

# Public Cloud control-plane endpoint. Do not use the Docker-only name `api` here.
SITE_PORTAL_CLOUD_API_BASE=https://cloud.example.com
SITE_PORTAL_CLOUD_CLIENT_ID=site-portal-official
SITE_PORTAL_CLOUD_CLIENT_SECRET=replace-with-the-secret-created-in-cloud-admin

# Standard OIDC authorization-code SSO. Production must use the HTTPS callback URL.
SITE_PORTAL_IDENTITY_AUTHORIZATION_URL=https://keycloak.example.com/realms/fly/protocol/openid-connect/auth
SITE_PORTAL_IDENTITY_TOKEN_URL=https://keycloak.example.com/realms/fly/protocol/openid-connect/token
SITE_PORTAL_IDENTITY_USERINFO_URL=https://keycloak.example.com/realms/fly/protocol/openid-connect/userinfo
SITE_PORTAL_IDENTITY_CLIENT_ID=replace-with-oidc-client-id
SITE_PORTAL_IDENTITY_CLIENT_SECRET=replace-with-oidc-client-secret
SITE_PORTAL_IDENTITY_SCOPE=openid
SITE_PORTAL_IDENTITY_PROFILE_FORMAT=oidc
SITE_PORTAL_IDENTITY_OPS_API_BASE_URL=

# External PRP provider. Upload is disabled unless the PRP team supplies an upload API endpoint.
SITE_PORTAL_PRP_BASE_URL=https://prp.example.com
SITE_PORTAL_UPLOAD_ENABLED=false
SITE_PORTAL_PRP_API_BASE_URL=

# The following demo settings are only for the legacy local mock stack.
SSO_DEMO_PORT=8081
SSO_DEMO_PUBLIC_BASE_URL=http://192.168.1.10:8081
SSO_OPERATOR_USERNAME=ops
SSO_OPERATOR_PASSWORD=replace-with-a-strong-operator-password

PRP_DEMO_PORT=8083
PRP_PUBLIC_BASE_URL=http://192.168.1.10:8083
PRP_TOKEN_SECRET=replace-with-a-random-shared-secret-at-least-32-chars
PRP_MAX_FILE_SIZE_BYTES=52428800
PRP_MAX_FILES_PER_USER=20
PRP_MAX_BYTES_PER_USER=209715200
PRP_MAX_TOTAL_BYTES=1073741824
PRP_FILE_TTL_SECONDS=604800
PRP_CLEANUP_INTERVAL_SECONDS=300

SITE_PORTAL_USER_SESSION_TTL=1h
# Production must use HTTPS and Secure cookies.
SITE_PORTAL_COOKIE_SECURE=true

# Optional: existing volume names when migrating a legacy local stack.
# SITE_PORTAL_SSO_DATA_VOLUME=fly-print-cloud_sso_login_demo_data
# SITE_PORTAL_PRP_DATA_VOLUME=fly-print-cloud_prp_demo_data
# SITE_PORTAL_DATA_VOLUME_EXTERNAL=true
