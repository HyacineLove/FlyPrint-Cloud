# FlyPrint Cloud offline release environment template.
# Copy this file to .env on the target host, then replace the example secrets.
# Site Portal and its configured SSO/file services are deployed separately at the site.

POSTGRES_DB=fly_print_cloud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CLOUD_API_IMAGE_TAG=flyprint/cloud-api:REPLACE_WITH_PACKAGE_TAG
APP_ENVIRONMENT=production
APP_DEBUG=false

STORAGE_PROVIDER=minio
STORAGE_DOWNLOAD_MODE=proxy
STORAGE_MAX_SIZE=10485760
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-this-minio-access-key
MINIO_SECRET_KEY=change-this-minio-secret-key
MINIO_BUCKET=fly-print-files
MINIO_USE_SSL=false
MINIO_OBJECT_PREFIX=
HTTP_PORT=80
# 临时 IP 阶段：替换为真实公网 IP，且 INSECURE_HTTP_UNTIL 不得超过启动后 7 天。
EXTERNAL_API_URL=http://203.0.113.10
ADMIN_CONSOLE_URL=http://203.0.113.10

CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_PASSWORD=change-this-admin-password

OAUTH2_MODE=builtin
OAUTH2_JWT_SIGNING_SECRET=change-this-jwt-signing-secret
OAUTH2_JWT_TOKEN_EXPIRY=3600
OAUTH2_JWT_ISSUER=fly-print-cloud
OAUTH_CLIENT_SECRET_ENCRYPTION_KEY=change-this-oauth-encryption-key

# Optional external OAuth mode values; leave empty while OAUTH2_MODE=builtin.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_AUTH_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_LOGOUT_URL=
# Keycloak 模式必须使用与 EXTERNAL_API_URL 同源的 /auth/callback；builtin 模式留空。
OAUTH2_REDIRECT_URI=
OAUTH2_LOGOUT_REDIRECT_URI_PARAM=post_logout_redirect_uri

# 必填：仅填写 Nginx 所在 Docker 网络 CIDR，例如 172.18.0.0/16；不得使用 0.0.0.0/0。
TRUSTED_PROXY_CIDRS=
UPLOAD_TOKEN_TTL=300
DOWNLOAD_TOKEN_TTL=300
ENTRY_COOKIE_SECURE=true
INSECURE_HTTP_MODE=false
INSECURE_HTTP_UNTIL=
FILE_ACCESS_SECRET=change-this-file-access-secret
ALLOWED_ORIGINS=https://print.example.com

# IP 阶段仅在明确接受明文风险时使用以下四项替换上面的 URL/Cookie/CORS 配置：
# EXTERNAL_API_URL=http://203.0.113.10
# ADMIN_CONSOLE_URL=http://203.0.113.10
# ALLOWED_ORIGINS=http://203.0.113.10
# ENTRY_COOKIE_SECURE=false
# INSECURE_HTTP_MODE=true
# INSECURE_HTTP_UNTIL=2026-08-18T12:00:00Z

# 域名 HTTPS 阶段：写入真实域名后使用 deploy/docker-compose.https.yml。
# EXTERNAL_API_URL=https://print.example.com
# ADMIN_CONSOLE_URL=https://print.example.com
# ALLOWED_ORIGINS=https://print.example.com
# ENTRY_COOKIE_SECURE=true
# INSECURE_HTTP_MODE=false
