# FlyPrint Cloud offline release environment template.
# Copy this file to .env on the target host, then replace the example secrets.
# Site Portal, SSO and PRP run as a separate private-network deployment.

POSTGRES_DB=fly_print_cloud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

STORAGE_PROVIDER=minio
STORAGE_DOWNLOAD_MODE=proxy
STORAGE_MAX_SIZE=10485760
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-this-minio-access-key
MINIO_SECRET_KEY=change-this-minio-secret-key
MINIO_BUCKET=fly-print-files
MINIO_USE_SSL=false
MINIO_OBJECT_PREFIX=
MINIO_PORT=127.0.0.1:9000
MINIO_CONSOLE_PORT=127.0.0.1:9001

HTTP_PORT=8012
EXTERNAL_API_URL=http://localhost:8012
ADMIN_CONSOLE_URL=http://localhost:8012

CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_PASSWORD=change-this-admin-password

OAUTH2_MODE=builtin
OAUTH2_JWT_SIGNING_SECRET=change-this-jwt-signing-secret
OAUTH2_JWT_TOKEN_EXPIRY=3600
OAUTH2_JWT_ISSUER=fly-print-cloud
OAUTH_CLIENT_SECRET_ENCRYPTION_KEY=change-this-oauth-encryption-key

# Optional external OAuth mode values; leave empty while OAUTH2_MODE=builtin.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_AUTH_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_LOGOUT_URL=
OAUTH2_REDIRECT_URI=http://localhost:8012/auth/callback
OAUTH2_LOGOUT_REDIRECT_URI_PARAM=post_logout_redirect_uri

TRUSTED_PROXY_CIDRS=
UPLOAD_TOKEN_TTL=300
DOWNLOAD_TOKEN_TTL=300
ENTRY_COOKIE_SECURE=true
FILE_ACCESS_SECRET=change-this-file-access-secret
ALLOWED_ORIGINS=http://localhost:8012,http://127.0.0.1:8012
